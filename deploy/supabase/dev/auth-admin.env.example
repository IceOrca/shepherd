# Generate auth-admin.env with: sh scripts/generate-auth-dev-env.sh
# Server-only ES256 signing material. Never expose these values through VITE_*
# variables or provide the private key to GoTrue.
AUTH_ADMIN_JWT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-pem
AUTH_ADMIN_JWT_KEY_ID=replace-with-admin-es256-key-id
