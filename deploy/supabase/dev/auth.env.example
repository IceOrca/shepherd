# Generate auth.env with: sh scripts/generate-auth-dev-env.sh
# Never commit the generated file or use development keys in production.
GOTRUE_JWT_SECRET=replace-with-at-least-32-random-characters
GOTRUE_JWT_KEYS=[]
GOTRUE_JWT_VALID_METHODS=EdDSA,ES256
AUTH_ACCESS_JWT_ROTATION_INTERVAL_SECS=63072000
AUTH_ACCESS_JWT_STANDBY_PROPAGATION_SECS=1200
AUTH_ACCESS_JWT_KEY_OVERLAP_SECS=3600
AUTH_ACCESS_JWT_CURRENT_KID=replace-with-current-ed25519-key-id
AUTH_ACCESS_JWT_CURRENT_CREATED_AT=replace-with-unix-timestamp
