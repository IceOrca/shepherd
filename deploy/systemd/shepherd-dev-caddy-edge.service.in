[Unit]
Description=Recover Shepherd development Caddy after its host address becomes available
Wants=network-online.target tailscaled.service
Requires=docker.service
After=network-online.target tailscaled.service docker.service
PartOf=docker.service

[Service]
Type=oneshot
User=@SHEPHERD_SERVICE_USER@
WorkingDirectory=@SHEPHERD_REPOSITORY_ROOT@
ExecStart=@SHEPHERD_REPOSITORY_ROOT@/scripts/recover-development-caddy-edge.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s
TimeoutStartSec=600s

[Install]
WantedBy=multi-user.target
