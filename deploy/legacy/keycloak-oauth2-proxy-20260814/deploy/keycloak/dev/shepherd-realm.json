{
  "realm": "shepherd",
  "enabled": true,
  "displayName": "Shepherd",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "client": {
      "shepherd-web": [
        {
          "name": "web-access",
          "description": "Allows an approved user to enter the Shepherd web application"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "shepherd-api",
      "name": "Shepherd API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "shepherd-web",
      "name": "Shepherd Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OAUTH2_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${OAUTH2_PROXY_REDIRECT_URL}"],
      "webOrigins": ["${SHEPHERD_PUBLIC_URL}"],
      "protocolMappers": [
        {
          "name": "shepherd-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "shepherd-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "shepherd-users",
      "path": "/shepherd-users",
      "clientRoles": {
        "shepherd-web": ["web-access"]
      }
    }
  ],
  "users": [
    {
      "id": "16f7594f-a100-414f-b0d0-3c02a611889a",
      "username": "phuongdorca",
      "enabled": true,
      "emailVerified": true,
      "email": "vampirephuong@gmail.com",
      "firstName": "IceOrca",
      "lastName": "Dev",
      "groups": ["/shepherd-users"],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
