{$SHEPHERD_SITE_ADDRESS::8081} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$SHEPHERD_API_UPSTREAM:127.0.0.1:8000}
	}

	handle /auth/* {
		reverse_proxy {$SHEPHERD_API_UPSTREAM:127.0.0.1:8000}
	}

	handle /openapi.json {
		reverse_proxy {$SHEPHERD_API_UPSTREAM:127.0.0.1:8000}
	}

	handle {
		root * {$SHEPHERD_WEB_ROOT:/var/www/shepherd}
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
