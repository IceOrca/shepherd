(common) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
}

# Public Shepherd application and authentication endpoints.
{$SHEPHERD_WEB_ORIGIN_PROD:https://erp.example.com} {
	import common
	root * {$SHEPHERD_WEB_DIST_ROOT:/var/www/shepherd/dist}

	handle_path /auth/v1/* {
		reverse_proxy {$AUTH_PROD_UPSTREAM:127.0.0.1:9999}
	}

	@api path /api/* /hr/* /business/*
	handle @api {
		reverse_proxy {$SHEPHERD_API_PROD_UPSTREAM:127.0.0.1:8000}
	}

	@immutable_assets {
		path /assets/*
		file
	}
	handle @immutable_assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /assets/* {
		respond 404
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
