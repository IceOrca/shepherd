{
  "realm": "shepherd",
  "enabled": true,
  "displayName": "Shepherd",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "client": {
      "shepherd-web": [
        {
          "name": "web-access",
          "description": "Allows an approved user to enter the Shepherd web application"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "shepherd-api",
      "name": "Shepherd API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "shepherd-web",
      "name": "Shepherd Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OAUTH2_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${OAUTH2_PROXY_REDIRECT_URL_PROD}"],
      "webOrigins": ["${SHEPHERD_WEB_ORIGIN_PROD}"],
      "protocolMappers": [
        {
          "name": "shepherd-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "shepherd-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "shepherd-users",
      "path": "/shepherd-users",
      "clientRoles": {
        "shepherd-web": ["web-access"]
      }
    }
  ]
}
