# Keep values shell-quoted because the GoTrue entrypoint sources this mounted
# file. Generate the JWT lines with scripts/generate-auth-production-keys.sh.
GOTRUE_JWT_SECRET='replace-with-generated-legacy-hmac-secret'
GOTRUE_JWT_KEYS='[]'
AUTH_ACCESS_JWT_CURRENT_KID='replace-with-current-ed25519-key-id'
AUTH_ACCESS_JWT_CURRENT_CREATED_AT='replace-with-unix-timestamp'
AUTH_ACCESS_JWT_ROTATION_INTERVAL_SECS='63072000'
AUTH_ACCESS_JWT_STANDBY_PROPAGATION_SECS='1200'
AUTH_ACCESS_JWT_KEY_OVERLAP_SECS='3600'

GOTRUE_SMTP_PASS='replace-with-smtp-password'
GOTRUE_EXTERNAL_GOOGLE_SECRET=''
GOTRUE_EXTERNAL_FACEBOOK_SECRET=''
