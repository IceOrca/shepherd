APP_ENV=production

POSTGRES_USER=postgresroot
POSTGRES_PASSWORD=""
POSTGRES_DB=shepherd
POSTGRES_PORT=5432

POSTGRES_USER_PROD=${POSTGRES_USER}
POSTGRES_DB_PROD=${POSTGRES_DB}
POSTGRES_PORT_PROD=${POSTGRES_PORT}

PG_APP_USER=shepherdapp
PG_APP_PASSWORD=StrongPw412365

REDIS_PORT_PROD=6379

BACKEND_PORT_PROD=8000
SHEPHERD_WEB_DIST_ROOT=/var/www/shepherd/dist

# Replace these documentation-only addresses before production deployment.
# Create an A record for AUTH_DNS_NAME_PROD pointing to PUBLIC_VPS_IPV4_PROD.
PUBLIC_VPS_IPV4_PROD=203.0.113.10
PUBLIC_VPS_IPV6_PROD=
SHEPHERD_WEB_ORIGIN_PROD=https://erp.example.com
AUTH_DNS_NAME_PROD=auth.example.com
AUTH_ORIGIN_PROD=https://${AUTH_DNS_NAME_PROD}
AUTH_PUBLIC_URL_PROD=${AUTH_ORIGIN_PROD}/auth/v1
AUTH_EDGE_PORT_PROD=9999
AUTH_DB=shepherd_auth
AUTH_DB_USER=shepherd_auth
AUTH_DATABASE_URL_PROD=postgres://shepherd_auth:replace-me@postgres-db:5432/shepherd_auth?search_path=auth
AUTH_AUDIENCE_PROD=authenticated
AUTH_JWT_ALGORITHMS_PROD=EdDSA
AUTH_JWT_EXPIRY_SECS_PROD=900
AUTH_JWT_SECRET_PROD=replace-with-at-least-32-random-characters
AUTH_JWT_KEYS_PROD=[]
AUTH_REDIRECT_ALLOW_LIST_PROD=https://erp.example.com/**
AUTH_SMTP_ADMIN_EMAIL_PROD=auth@example.com
AUTH_SMTP_HOST_PROD=smtp.example.com
AUTH_SMTP_PORT_PROD=587
AUTH_SMTP_USER_PROD=auth@example.com
AUTH_SMTP_PASSWORD_PROD=replace-me
AUTH_GOOGLE_ENABLED_PROD=false
AUTH_FACEBOOK_ENABLED_PROD=false

SVR_SECRETS_DIR=/etc/shepherd/secrets

COMPOSE_FILE=compose.yaml:compose.prod.yaml
