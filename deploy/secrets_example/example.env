APP_ENV=production

POSTGRES_USER=postgresroot
POSTGRES_PASSWORD=""
POSTGRES_DB=shepherd
POSTGRES_PORT=5432

POSTGRES_USER_PROD=${POSTGRES_USER}
POSTGRES_DB_PROD=${POSTGRES_DB}
POSTGRES_PORT_PROD=${POSTGRES_PORT}

PG_APP_USER=shepherdapp

BACKEND_PORT_PROD=8000
SHEPHERD_API_PROD_UPSTREAM=server:8000
SHEPHERD_SERVER_IMAGE=iceorca/shepherd-srv:0.1.0
SHEPHERD_WEB_IMAGE=iceorca/shepherd-web:0.1.0
HTTP_RATE_LIMIT_PUBLIC_REPLENISH_MILLIS_PROD=500
HTTP_RATE_LIMIT_PUBLIC_BURST_PROD=30
HTTP_RATE_LIMIT_IDENTITY_REPLENISH_MILLIS_PROD=100
HTTP_RATE_LIMIT_IDENTITY_BURST_PROD=120
HTTP_RATE_LIMIT_ADMIN_REPLENISH_MILLIS_PROD=1000
HTTP_RATE_LIMIT_ADMIN_BURST_PROD=20
HTTP_RATE_LIMIT_PROTECTED_REPLENISH_MILLIS_PROD=200
HTTP_RATE_LIMIT_PROTECTED_BURST_PROD=80
HTTP_RATE_LIMIT_HIGH_FREQUENCY_REPLENISH_MILLIS_PROD=100
HTTP_RATE_LIMIT_HIGH_FREQUENCY_BURST_PROD=120
HTTP_RATE_LIMIT_STRICT_REPLENISH_MILLIS_PROD=2000
HTTP_RATE_LIMIT_STRICT_BURST_PROD=10
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.5
CADDY_PIDS_LIMIT=128

# Operator identity recorded by the one-shot tenant bootstrap tool. Put the
# corresponding secret in ${SVR_SECRETS_DIR}/tenant_bootstrap_admin_secret.
TENANT_BOOTSTRAP_ADMIN_ACCOUNT_PROD=iceorca
TENANT_BOOTSTRAP_ADMIN_EMAIL_PROD=iceorca.admin@example.com
TENANT_BOOTSTRAP_MEMORY_LIMIT=256m
TENANT_BOOTSTRAP_CPU_LIMIT=0.5
TENANT_BOOTSTRAP_PIDS_LIMIT=64

# Public deployment addresses. Create A records for both the web hostname and
# AUTH_DNS_NAME_PROD pointing to PUBLIC_VPS_IPV4_PROD before starting Caddy.
PUBLIC_VPS_IPV4_PROD=103.153.68.125
PUBLIC_VPS_IPV6_PROD=
SHEPHERD_WEB_ORIGIN_PROD=https://www.entertainment17.work
AUTH_DNS_NAME_PROD=auth.entertainment17.work
AUTH_ORIGIN_PROD=https://${AUTH_DNS_NAME_PROD}
AUTH_PUBLIC_URL_PROD=${AUTH_ORIGIN_PROD}/auth/v1
AUTH_PROD_UPSTREAM=supabase-auth:9999
AUTH_DB_USER=supabase_auth_admin
AUTH_AUDIENCE_PROD=authenticated
AUTH_JWT_ALGORITHMS_PROD=EdDSA
AUTH_JWT_EXPIRY_SECS_PROD=900
AUTH_JWT_VALID_METHODS_PROD=EdDSA,ES256
AUTH_ADMIN_JWT_ALGORITHM_PROD=ES256
AUTH_ADMIN_JWT_ROLE_PROD=service_role
AUTH_ADMIN_JWT_EXPIRY_SECS_PROD=600
AUTH_ACCESS_JWT_ROTATION_INTERVAL_SECS=63072000
AUTH_ACCESS_JWT_STANDBY_PROPAGATION_SECS=1200
AUTH_ACCESS_JWT_KEY_OVERLAP_SECS=3600
AUTH_REDIRECT_ALLOW_LIST_PROD=https://www.entertainment17.work/**
ACME_EMAIL_PROD=replace-with-real-email@entertainment17.work
AUTH_SMTP_ADMIN_EMAIL_PROD=auth@example.com
AUTH_SMTP_HOST_PROD=smtp.example.com
AUTH_SMTP_PORT_PROD=587
AUTH_SMTP_USER_PROD=auth@example.com
AUTH_GOOGLE_ENABLED_PROD=false
AUTH_GOOGLE_CLIENT_ID_PROD=
AUTH_FACEBOOK_ENABLED_PROD=false
AUTH_FACEBOOK_CLIENT_ID_PROD=

SVR_SECRETS_DIR=/etc/shepherd/secrets

COMPOSE_FILE=compose.yaml:compose.prod.yaml
