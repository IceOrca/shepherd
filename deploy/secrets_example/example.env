PG_APP_USER=shepherdapp
PG_APP_PASSWORD=StrongPw412365

REDIS_PORT_PROD=6379

BACKEND_PORT_PROD=8000
FRONTEND_HTTP_PORT=8080

# Host Caddy reaches these loopback-only Compose ports.
KEYCLOAK_EDGE_PORT_PROD=8081
OAUTH2_PROXY_EDGE_PORT_PROD=4180

REMOTE_DEV_DNS_NAME=vht-precision-7540.tailf57e36.ts.net
KEYCLOAK_CADDY_HTTPS_PORT=8443
KEYCLOAK_ADMIN_USERNAME_PROD=admin
KEYCLOAK_HOSTNAME_PROD=https://auth.example.com
KEYCLOAK_ADMIN_URL_PROD=https://${REMOTE_DEV_DNS_NAME}:${KEYCLOAK_CADDY_HTTPS_PORT}
KEYCLOAK_ISSUER_URL_PROD=https://auth.example.com/realms/shepherd
OAUTH2_PROXY_CLIENT_ID_PROD=shepherd-web
OAUTH2_PROXY_REDIRECT_URL_PROD=https://erp.example.com/oauth2/callback
OAUTH2_PROXY_ALLOWED_ROLES_PROD=shepherd-web:web-access
