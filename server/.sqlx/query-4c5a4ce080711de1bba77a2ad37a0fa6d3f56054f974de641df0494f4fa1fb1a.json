  "query": "\n                SELECT id, code, name, time_zone, status, version\n                FROM branches\n                WHERE tenant_id = $1\n                  AND ($2::TEXT IS NULL OR (lower(name), id) > ($2, $3))\n                ORDER BY lower(name), id\n                LIMIT $4\n                ",
