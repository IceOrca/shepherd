  "db_name": "PostgreSQL",
  "query": "SELECT role.code, role.display_name, role.description, role.scope_type, role.is_system, role.is_active, role.version, COUNT(DISTINCT assignment.account_id)::BIGINT AS \"assigned_account_count!\" FROM tenant_roles AS role LEFT JOIN account_role_assignments AS assignment ON assignment.tenant_id = role.tenant_id AND assignment.role_code = role.code WHERE role.tenant_id = $1 AND role.code = $2 GROUP BY role.tenant_id, role.code",
