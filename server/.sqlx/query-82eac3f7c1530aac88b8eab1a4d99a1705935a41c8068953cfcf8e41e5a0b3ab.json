{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT id, code, name, time_zone\n                    FROM branches\n                    WHERE tenant_id = $1\n                      AND status = 'active'\n                      AND id = ANY($2)\n                      AND ($3::TEXT IS NULL\n                           OR lower(name) LIKE '%' || $3 || '%'\n                           OR lower(code) LIKE '%' || $3 || '%')\n                      AND ($4::TEXT IS NULL OR (lower(name), code, id) > ($4, $5, $6))\n                    ORDER BY lower(name), code, id\n                    LIMIT $7\n                    ",
