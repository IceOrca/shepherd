  "query": "\n                    SELECT id, code, name, status, created_at, updated_at\n                    FROM business_staffing_jobs\n                    WHERE tenant_id = $1\n                      AND ($2::TEXT IS NULL\n                           OR lower(name) LIKE '%' || $2 || '%'\n                           OR lower(code) LIKE '%' || $2 || '%')\n                      AND ($3::TEXT IS NULL OR (lower(name), code, id) > ($3, $4, $5))\n                    ORDER BY lower(name), code, id\n                    LIMIT $6\n                    ",
