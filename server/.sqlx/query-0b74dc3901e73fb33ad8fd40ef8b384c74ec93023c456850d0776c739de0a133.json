{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT id, code, name, time_zone, status, version\n                    FROM branches\n                    WHERE tenant_id = $1\n                      AND (\n                          $3::TEXT IS NULL\n                          OR code LIKE '%' || $3 || '%'\n                          OR lower(name) LIKE '%' || $3 || '%'\n                      )\n                      AND (\n                          $4::TEXT IS NULL\n                          OR (code, id) > ($4, $5::UUID)\n                      )\n                    ORDER BY code, id\n                    LIMIT $2\n                    ",
