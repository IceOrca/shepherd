  "query": "\n                SELECT code, display_name, description\n                FROM permissions\n                WHERE $1::TEXT IS NULL\n                   OR (lower(display_name), code) > ($1, $2)\n                ORDER BY lower(display_name), code\n                LIMIT $3\n                ",
