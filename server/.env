RUST_LOG="debug"
SQLX_OFFLINE=false
DATABASE_URL=
REDIS_CACHE_URL=
REDIS_QUEUE_URL=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
DB_MAX_CONNECTIONS="15"
DB_ACQUIRE_TIMEOUT_SECS="10"
DB_CONNECT_TIMEOUT_SECS="5"
DB_STATEMENT_TIMEOUT_MS="30000"
DB_LOCK_TIMEOUT_MS="5000"
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS="40000"
TENANT_OWNER_JWT_EXPIRATION_SECS="900"
SUPERVISOR_JWT_EXPIRATION_SECS="900"
EMPLOYEE_JWT_EXPIRATION_SECS="900"
REFRESH_TOKEN_EXPIRATION_SECS="2592000" # 30 days
TENANT_OWNER_MAX_SESSION="4"
SUPERVISOR_MAX_SESSION="3"
EMPLOYEE_MAX_SESSION="3"
TENANT_OWNER_AUTH_SESSION_IDLE_TIMEOUT_SECS="7200"
SUPERVISOR_AUTH_SESSION_IDLE_TIMEOUT_SECS="7200"
EMPLOYEE_AUTH_SESSION_IDLE_TIMEOUT_SECS="7200"

TENANT_OWNER_BRUTE_FORCE_MAX_FAILURES="5"
TENANT_OWNER_BRUTE_FORCE_WINDOW_SECS="300"
TENANT_OWNER_BRUTE_FORCE_LOCKOUT_SECS="900"
SUPERVISOR_BRUTE_FORCE_MAX_FAILURES="5"
SUPERVISOR_BRUTE_FORCE_WINDOW_SECS="300"
SUPERVISOR_BRUTE_FORCE_LOCKOUT_SECS="900"
EMPLOYEE_BRUTE_FORCE_MAX_FAILURES="5"
EMPLOYEE_BRUTE_FORCE_WINDOW_SECS="300"
EMPLOYEE_BRUTE_FORCE_LOCKOUT_SECS="900"

HOST_IP="localhost"
HOST_PORT="8000"
HTTP_REQUEST_TIMEOUT_SECS="45"
RUST_BACKTRACE=1
