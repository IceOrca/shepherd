{
  "name": "Shepherd Rust Backend",
  "dockerComposeFile": "../../compose.yaml",
  "service": "server",
  "workspaceFolder": "/app/shepherd_server",
  "postCreateCommand": "cargo fetch",
  "postStartCommand": "sh scripts/rust-analyzer-check.sh --maintenance-only",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens",
      ],
      "settings": {
        "rust-analyzer.cargo.targetDir": "target/rust-analyzer",
        "rust-analyzer.check.overrideCommand": [
          "sh",
          "scripts/rust-analyzer-check.sh",
        ],
        "rust-analyzer.cargo.extraEnv": {
          "DATABASE_URL": "${containerEnv:DATABASE_URL}",
          "RUST_ANALYZER_TARGET_DIR": "target/rust-analyzer",
          "RUST_ANALYZER_TARGET_MAX_MIB": "8192",
          "RUST_ANALYZER_TARGET_CHECK_INTERVAL_SECS": "86400",
        },
        "rust-analyzer.runnables.extraEnv": {
          "DATABASE_URL": "${containerEnv:DATABASE_URL}",
        },
      },
    },
  },
  "containerEnv": {
    // "DATABASE_URL": "${containerEnv:DATABASE_URL}",
    // "PATH": "/usr/local/cargo/bin:${containerEnv:PATH}",
  },
  "remoteEnv": {
    // "DATABASE_URL": "${containerEnv:DATABASE_URL}",
    "PATH": "/usr/local/cargo/bin:${containerEnv:PATH}",
  },
  // "runArgs": ["--env-file", ".devcontainer/backend/devcontainer.env"],
  "remoteUser": "root",
  "containerUser": "root",
}
