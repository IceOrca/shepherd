FROM node:24-alpine AS builder
WORKDIR /app/shepherd_client

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# BuildKit can export this target directly to the host for Caddy to serve:
# docker build --file Dockerfile.prod --target export --output type=local,dest=dist .
FROM scratch AS export
COPY --from=builder /app/shepherd_client/dist /
