APP_ENV=development

POSTGRES_USER=postgresroot
POSTGRES_PASSWORD=012345679aAbC
POSTGRES_DB=shepherd_dev
POSTGRES_PORT=5432

PG_APP_USER=shepherdapp
PG_APP_PASSWORD=01234567
DATABASE_URL=postgres://${PG_APP_USER}:${PG_APP_PASSWORD}@postgres-db:${POSTGRES_PORT}/${POSTGRES_DB}

AUTH_DB=shepherd_auth_dev
AUTH_DB_USER=shepherd_auth
AUTH_DB_PASSWORD=76543210
AUTH_PORT=9999

# Remote development origins. Compose consumes the derived URLs; Caddy only
# needs REMOTE_DEV_DNS_NAME and keeps the node name out of compose.yaml.
REMOTE_DEV_DNS_NAME=vht-precision-7540.tailf57e36.ts.net
REMOTE_DEV_BIND_IP=100.66.191.27
SHEPHERD_PUBLIC_URL=https://${REMOTE_DEV_DNS_NAME}
AUTH_PUBLIC_URL=${SHEPHERD_PUBLIC_URL}/auth/v1
AUTH_ISSUER_URL=${AUTH_PUBLIC_URL}
AUTH_AUDIENCE=authenticated
AUTH_JWT_ALGORITHMS=EdDSA
AUTH_JWT_EXPIRY_SECS=900
# Set this to the UUID `sub` of the Supabase Auth development user before
# running shepherd-dev-db-seeding.
AUTH_DEV_SUBJECT=

# Optional social login providers. Their secrets remain empty in development
# until matching applications are registered with the provider.
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis-cache:${REDIS_PORT}/0
REDIS_QUEUE_URL=

BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
FRONTEND_HTTP_PORT=8080

JWT_PRIVATE_KEY_PATH=./security/jwtkey_dev/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./security/jwtkey_dev/jwt_public.pem

COMPOSE_FILE=compose.yaml
