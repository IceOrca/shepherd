APP_ENV=development

POSTGRES_USER=postgresroot
POSTGRES_PASSWORD=012345679aAbC
POSTGRES_DB=shepherd_dev
POSTGRES_PORT=5432

PG_APP_USER=shepherdapp
PG_APP_PASSWORD=01234567
DATABASE_URL=postgres://${PG_APP_USER}:${PG_APP_PASSWORD}@postgresql-db:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_PORT=6379
# Redis DB 0 is reserved for Shepherd and the optional legacy-auth features.
REDIS_CACHE_URL=redis://redis-cache:${REDIS_PORT}/0
REDIS_QUEUE_URL=

BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
FRONTEND_HTTP_PORT=8080

# Only Keycloak users with this client role may pass oauth2-proxy.
OAUTH2_PROXY_ALLOWED_ROLES=shepherd-web:web-access

JWT_PRIVATE_KEY_PATH=./security/jwtkey_dev/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./security/jwtkey_dev/jwt_public.pem

COMPOSE_FILE=compose.yaml
