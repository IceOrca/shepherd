APP_ENV=development

POSTGRES_USER=postgresroot
POSTGRES_PASSWORD=012345679aAbC
POSTGRES_DB=shepherd_dev
POSTGRES_PORT=5432

PG_APP_USER=shepherdapp
PG_APP_PASSWORD=01234567
DATABASE_URL=postgres://${PG_APP_USER}:${PG_APP_PASSWORD}@postgres-db:${POSTGRES_PORT}/${POSTGRES_DB}

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=KC9876543210CK

KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak_dev
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=76543210
KEYCLOAK_DB=${KC_DB_URL_DATABASE}
KEYCLOAK_DB_USER=${KC_DB_USERNAME}
KEYCLOAK_DB_PASSWORD=${KC_DB_PASSWORD}
KEYCLOAK_DEV_USER_PASSWORD="mypw132xXx"

# Remote development origins. Compose consumes the derived URLs; Caddy only
# needs REMOTE_DEV_DNS_NAME and keeps the node name out of compose.yaml.
REMOTE_DEV_DNS_NAME=vht-precision-7540.tailf57e36.ts.net
REMOTE_DEV_BIND_IP=100.66.191.27
KEYCLOAK_CADDY_HTTPS_PORT=8443
SHEPHERD_PUBLIC_URL=https://${REMOTE_DEV_DNS_NAME}
KEYCLOAK_PUBLIC_URL=https://${REMOTE_DEV_DNS_NAME}:${KEYCLOAK_CADDY_HTTPS_PORT}
KEYCLOAK_ISSUER_URL=${KEYCLOAK_PUBLIC_URL}/realms/shepherd
OAUTH2_PROXY_REDIRECT_URL=${SHEPHERD_PUBLIC_URL}/oauth2/callback

OAUTH2_PROXY_CLIENT_SECRET=shepherd-dev-oauth2-client-secret
OAUTH2_PROXY_COOKIE_SECRET=shepherd-dev-cookie-secret-32chx

# Only Keycloak users with this client role may pass oauth2-proxy.
OAUTH2_PROXY_CLIENT_ID=shepherd-web
OAUTH2_PROXY_ALLOWED_ROLES=shepherd-web:web-access

REDIS_PORT=6379
# Redis DB 0 is reserved for Shepherd and the optional legacy-auth features.
REDIS_CACHE_URL=redis://redis-cache:${REDIS_PORT}/0
REDIS_QUEUE_URL=

BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
FRONTEND_HTTP_PORT=8080

JWT_PRIVATE_KEY_PATH=./security/jwtkey_dev/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./security/jwtkey_dev/jwt_public.pem

COMPOSE_FILE=compose.yaml
