APP_ENV=development

POSTGRES_USER=postgresroot
POSTGRES_PASSWORD=012345679aAbC
POSTGRES_DB=shepherd_dev
POSTGRES_PORT=5432

PG_APP_USER=shepherdapp
PG_APP_PASSWORD=01234567
DATABASE_URL=postgres://${PG_APP_USER}:${PG_APP_PASSWORD}@postgres-db:${POSTGRES_PORT}/${POSTGRES_DB}?options=-csearch_path%3Dpublic

AUTH_DB_USER=supabase_auth_admin
AUTH_DB_PASSWORD=76543210
AUTH_PORT=9999

# Remote development origins. AUTH_DEV_DNS_NAME must resolve to the same
# REMOTE_DEV_BIND_IP as REMOTE_DEV_DNS_NAME on every development browser/device.
REMOTE_DEV_DNS_NAME=vht-precision-7540.tailf57e36.ts.net
AUTH_DEV_DNS_NAME=auth.${REMOTE_DEV_DNS_NAME}
REMOTE_DEV_BIND_IP=100.66.191.27
SHEPHERD_PUBLIC_URL=https://${REMOTE_DEV_DNS_NAME}
AUTH_PUBLIC_URL=https://${AUTH_DEV_DNS_NAME}/auth/v1
AUTH_ISSUER_URL=${AUTH_PUBLIC_URL}
AUTH_AUDIENCE=authenticated
AUTH_JWT_ALGORITHMS=EdDSA
AUTH_JWT_EXPIRY_SECS=900
AUTH_JWT_VALID_METHODS=EdDSA,ES256
AUTH_ADMIN_JWT_ALGORITHM=ES256
AUTH_ADMIN_JWT_ROLE=service_role
AUTH_ADMIN_JWT_EXPIRY_SECS=600
AUTH_ACCESS_JWT_ROTATION_INTERVAL_SECS=63072000
AUTH_ACCESS_JWT_STANDBY_PROPAGATION_SECS=1200
AUTH_ACCESS_JWT_KEY_OVERLAP_SECS=3600
AUTH_DEV_HEALTH_MAX_ATTEMPTS=30
AUTH_DEV_HEALTH_INTERVAL_SECS=1
AUTH_DB_STARTUP_TIMEOUT_SECS=240
AUTH_DB_STARTUP_RETRY_INTERVAL_SECS=2
AUTH_DB_STARTUP_PROBE_TIMEOUT_SECS=2

# Operator-only one-shot tenant bootstrap identity. This is not a tenant login.
TENANT_BOOTSTRAP_ADMIN_ACCOUNT=iceorca
TENANT_BOOTSTRAP_ADMIN_EMAIL=iceorca.admin@shepherd.local
TENANT_BOOTSTRAP_ADMIN_SECRET=01234567aA

# Optional social login providers. Their secrets remain empty in development
# until matching applications are registered with the provider.
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis-cache:${REDIS_PORT}/0
REDIS_QUEUE_URL=

BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
FRONTEND_HTTP_PORT=8080

# HTTP request throttling. Protected requests are keyed by authenticated
# principal; public and strict-public requests are keyed by trusted origin IP.
HTTP_RATE_LIMIT_PUBLIC_REPLENISH_MILLIS=500
HTTP_RATE_LIMIT_PUBLIC_BURST=30
HTTP_RATE_LIMIT_IDENTITY_REPLENISH_MILLIS=100
HTTP_RATE_LIMIT_IDENTITY_BURST=120
HTTP_RATE_LIMIT_ADMIN_REPLENISH_MILLIS=1000
HTTP_RATE_LIMIT_ADMIN_BURST=20
HTTP_RATE_LIMIT_PROTECTED_REPLENISH_MILLIS=200
HTTP_RATE_LIMIT_PROTECTED_BURST=80
HTTP_RATE_LIMIT_HIGH_FREQUENCY_REPLENISH_MILLIS=100
HTTP_RATE_LIMIT_HIGH_FREQUENCY_BURST=120
HTTP_RATE_LIMIT_STRICT_REPLENISH_MILLIS=2000
HTTP_RATE_LIMIT_STRICT_BURST=10

JWT_PRIVATE_KEY_PATH=./security/jwtkey_dev/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./security/jwtkey_dev/jwt_public.pem

COMPOSE_FILE=compose.yaml
